POST http://localhost:8080/api/notices
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJtYW5hZ2VyQHJlc2lpZG8uY29tIiwiaWF0IjoxNzcxNjY0Njg1LCJleHAiOjE3NzE3MDA2ODV9.BY3G0-IQU7aoXGjiy5onxIjJWZsw95tqcnw3V1uNrfQ

