Authorization: Bearer eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJib2JAcmVzaWlkby5jb20iLCJpYXQiOjE3NzE2NjQ3MzMsImV4cCI6MTc3MTcwMDczM30.ExfIxoJt7WD-0Cs50Dw6H9AMJj3ch3ByTOWY0wuKcrg

### ---------------------------------------------------

### 5. SECURITY TEST - RESIDENT: Tries to delete a notice (Should FAIL with 403 Forbidden)
# Change '1' to the ID of the Water Shutoff Notice.
# Your code should block Bob from deleting Alice's official notice.
DELETE http://localhost:8080/api/notices/3
