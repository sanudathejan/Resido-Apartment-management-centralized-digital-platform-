### ==========================================
### PARKING REQUEST TESTS (PEER-TO-PEER)
### ==========================================

### 1. OWNER (Resident): Make my slot available for lending
# Bob decides he doesn't need his spot this weekend.
PUT http://localhost:8080/api/parking/my-slot/availability?available=true
Authorization: Bearer eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJib2JAcmVzaWlkby5jb20iLCJpYXQiOjE3NzE2NjQ3MzMsImV4cCI6MTc3MTcwMDczM30.ExfIxoJt7WD-0Cs50Dw6H9AMJj3ch3ByTOWY0wuKcrg

### ---------------------------------------------------

### 2. BORROWER (Manager): View all available slots
# Alice checks what slots are free. She should see Bob's slot here!
# Note the "id" of the parking slot in the response (likely 1).
GET http://localhost:8080/api/parking/available
Authorization: Bearer eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJtYW5hZ2VyQHJlc2lpZG8uY29tIiwiaWF0IjoxNzcxNjY0Njg1LCJleHAiOjE3NzE3MDA2ODV9.BY3G0-IQU7aoXGjiy5onxIjJWZsw95tqcnw3V1uNrfQ

### ---------------------------------------------------

### 3. BORROWER (Manager): Request the available slot
# Replace '1' inside the slot object with the actual Parking Slot ID from Step 2.
POST http://localhost:8080/api/parking/request
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJtYW5hZ2VyQHJlc2lpZG8uY29tIiwiaWF0IjoxNzcxNjY0Njg1LCJleHAiOjE3NzE3MDA2ODV9.BY3G0-IQU7aoXGjiy5onxIjJWZsw95tqcnw3V1uNrfQ

{
  "slot": { "id": 12 },
  "startTime": "2026-03-05T10:00:00",
  "endTime": "2026-03-05T18:00:00"
}

### ---------------------------------------------------

### 4. BORROWER (Manager): Check my outgoing requests
# Alice verifies her request is in the system (Status: PENDING)
GET http://localhost:8080/api/parking/my-requests
Authorization: Bearer eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJtYW5hZ2VyQHJlc2lpZG8uY29tIiwiaWF0IjoxNzcxNjY0Njg1LCJleHAiOjE3NzE3MDA2ODV9.BY3G0-IQU7aoXGjiy5onxIjJWZsw95tqcnw3V1uNrfQ

### ---------------------------------------------------

### 5. OWNER (Resident): View pending requests for my slot
# Bob sees that Alice wants to borrow his spot.
GET http://localhost:8080/api/parking/my-slot/pending
Authorization: Bearer eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJib2JAcmVzaWlkby5jb20iLCJpYXQiOjE3NzE2NjQ3MzMsImV4cCI6MTc3MTcwMDczM30.ExfIxoJt7WD-0Cs50Dw6H9AMJj3ch3ByTOWY0wuKcrg

### ---------------------------------------------------

### 6. OWNER (Resident): Approve the request
# Replace '1' with the actual Parking REQUEST ID from Step 5.
PUT http://localhost:8080/api/parking/request/2?status=APPROVED
Authorization: Bearer eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJib2JAcmVzaWlkby5jb20iLCJpYXQiOjE3NzE2NjQ3MzMsImV4cCI6MTc3MTcwMDczM30.ExfIxoJt7WD-0Cs50Dw6H9AMJj3ch3ByTOWY0wuKcrg

### ---------------------------------------------------

### 7. OWNER (Resident): Try to cancel the APPROVED request (Should FAIL)
# Bob tries to back out after approving. Your code should block this with a 403 Forbidden!
DELETE http://localhost:8080/api/parking/request/2
Authorization: Bearer eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJib2JAcmVzaWlkby5jb20iLCJpYXQiOjE3NzE2NjQ3MzMsImV4cCI6MTc3MTcwMDczM30.ExfIxoJt7WD-0Cs50Dw6H9AMJj3ch3ByTOWY0wuKcrg

### ---------------------------------------------------

### 8. BORROWER (Manager): Cancel the request (Should SUCCEED)
# Alice realizes she doesn't need it anymore and cancels. Your code allows borrowers to cancel anytime.
DELETE http://localhost:8080/api/parking/request/2
Authorization: Bearer eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJtYW5hZ2VyQHJlc2lpZG8uY29tIiwiaWF0IjoxNzcxNjY0Njg1LCJleHAiOjE3NzE3MDA2ODV9.BY3G0-IQU7aoXGjiy5onxIjJWZsw95tqcnw3V1uNrfQ

### ---------------------------------------------------

### 9. OWNER (Resident): Turn off availability
# Bob returns and marks his spot as unavailable again.
PUT http://localhost:8080/api/parking/my-slot/availability?available=false
Authorization: Bearer eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJib2JAcmVzaWlkby5jb20iLCJpYXQiOjE3NzE2NjQ3MzMsImV4cCI6MTc3MTcwMDczM30.ExfIxoJt7WD-0Cs50Dw6H9AMJj3ch3ByTOWY0wuKcrg

### BORROWER tries to approve their own request on someone else's slot (Should FAIL with 403)
PUT http://localhost:8080/api/parking/request/3?status=APPROVED
Authorization: Bearer eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJtYW5hZ2VyQHJlc2lpZG8uY29tIiwiaWF0IjoxNzcxNjY0Njg1LCJleHAiOjE3NzE3MDA2ODV9.BY3G0-IQU7aoXGjiy5onxIjJWZsw95tqcnw3V1uNrfQ






### ==========================================
### NOTICES FEATURE TESTS (BULLETIN BOARD)
### ==========================================

### 1. MANAGER: Posts a new notice
POST http://localhost:8080/api/notices
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJtYW5hZ2VyQHJlc2lpZG8uY29tIiwiaWF0IjoxNzcxNjY0Njg1LCJleHAiOjE3NzE3MDA2ODV9.BY3G0-IQU7aoXGjiy5onxIjJWZsw95tqcnw3V1uNrfQ

